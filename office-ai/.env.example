# Sao chép file này thành ".env" rồi điền key thật vào. Không thêm dấu ngoặc kép, không có khoảng trắng quanh dấu =
ANTHROPIC_API_KEY=sk-ant-dien-key-cua-ban-vao-day

# Supabase Auth dùng chung với trang quản lý công việc.
# Publishable key được phép xuất hiện trong browser; KHÔNG đặt secret/service_role key ở đây.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SESSION_STORAGE=0

# Tên bệnh viện, hiện ở đầu file Word (tùy chọn)
HOSPITAL_NAME=

# Tùy chọn khác (bỏ dấu # ở đầu dòng để dùng)
# MODEL_LEAD=claude-sonnet-5-5
# MODEL_AGENT=claude-haiku-5-5
# WORKERS=8
# WEB_SEARCH=1

